# Generate with: pnpm exec auth secret
AUTH_SECRET=replace-with-at-least-32-random-characters

# Use a unique passphrase with at least 12 characters. Store the real value only
# in `.env.local` and in Vercel's protected environment-variable settings.
HANDOFF_PASSWORD=replace-with-a-long-unique-passphrase

# Vercel sets its trusted-host signal automatically. Set this to true only when
# running a production build on another trusted hosting platform.
AUTH_TRUST_HOST=false
